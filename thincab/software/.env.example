# Copy to .env and customize for your local network. Never commit .env.

# Remote host for Wake-on-LAN
HOST_MAC="00:00:00:00:00:00"
HOST_BROADCAST="192.168.1.255"

# Remote Desktop (FreeRDP) target
RDP_HOST="192.168.1.100"
RDP_USER="your-username"

# Kiosk browser start URL
KIOSK_URL="https://example.com"
